# --- Core ---
# Clé admin pour créer/clôturer/tirer les raffles (header x-admin-key)
ADMIN_KEY=change-me-please

# DEMO_MODE=true : invoices simulées + tirage sur le bloc courant (instantané).
# DEMO_MODE=false : LNbits requis + tirage sur un bloc futur (tip + 6).
DEMO_MODE=true

# --- Lightning (LNbits) — requis si DEMO_MODE=false ---
# LNBITS_URL=http://localhost:5000
# LNBITS_INVOICE_KEY=your-invoice-read-key

# --- Bitcoin block source (randomness) ---
# Optional: preferred Esplora-compatible API. blockstream.info and
# mempool.space are always tried as fallbacks.
# MEMPOOL_API=https://mempool.space/api

# --- Nostr (optionnel : publication transparente des raffles/tirages) ---
# Générer avec: npm run seed -- --gen-nsec
# NOSTR_NSEC=nsec1...
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
